{
  "name": "vocabdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write src tests prisma.config.ts *.json *.mjs *.ts",
    "format:check": "prettier --check src tests prisma.config.ts *.json *.mjs *.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "ts-fsrs": "6.0.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
