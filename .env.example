# Copy to .env.local. Never commit credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only needed for future programmatic invitations; MVP uses the Dashboard.
SUPABASE_SECRET_KEY=
# App connection: limited vocabdeck_app role via transaction pooler (6543).
DATABASE_URL=
# Migration connection: privileged direct/session connection (5432).
DIRECT_URL=
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
AI_ENABLED=false
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=100
AI_GLOBAL_CONCURRENCY=5
# Test database must be disposable; do not use staging or production.
TEST_DATABASE_URL=
